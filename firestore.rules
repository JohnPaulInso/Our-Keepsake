rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /couples/jp_zea_vault {
      allow read, write: if request.auth != null;
    }
    match /couples/jp_zea_vault/daily_backups/{id} {
      allow read, write: if request.auth != null;
    }
    match /post_media/{id} {
      allow read, write: if request.auth != null;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
